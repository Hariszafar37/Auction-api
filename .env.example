# Use pk_test_ / sk_test_ keys on all non-production environments.
# The app will REFUSE TO BOOT if live keys (pk_live_ / sk_live_) are detected
# outside the production environment — this prevents accidental real charges.
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Reverse proxy / load balancer trust — required for correct client IP capture
# (e.g. the admin account-restriction audit log) when the app runs behind nginx,
# an AWS ELB, Cloudflare, etc. Leave unset locally.
#   '*'                     → trust all proxies (typical single LB in front)
#   '10.0.0.1,192.168.1.0/24' → trust only these proxy IPs / CIDRs
TRUSTED_PROXIES=

# API token idle timeout, in minutes. Tokens are issued with a per-role expiry
# that the SlidingTokenExpiration middleware pushes forward on every
# authenticated request, so these are INACTIVITY windows, not hard caps from
# login. Privileged applies to the admin and staff roles; standard covers
# buyer / dealer / seller. Leave unset to use the defaults shown.
TOKEN_LIFETIME_PRIVILEGED_MINUTES=60
TOKEN_LIFETIME_STANDARD_MINUTES=180

# Minimum seconds between expires_at writes. Caps the sliding renewal at one
# extra UPDATE per token per window instead of one per request.
TOKEN_SLIDE_THROTTLE_SECONDS=60
